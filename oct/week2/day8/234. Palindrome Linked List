#leetcode Q234
# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: ListNode | None) -> bool:
        nums=[]
        while head:
            nums.append(head.val)#putting all the vals in the linkedlist into a list
            head=head.next
        l=0
        r= len(nums)-1
        while l<r:#check if list is a palindrome
            if nums[l]!=nums[r]:
                return False
            l+=1
            r-=1
        return True
