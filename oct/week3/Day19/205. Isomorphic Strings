#leetcode Q205
class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:
        s_to_t = {}#2 hashmaps 
        t_to_s = {}

        for i in range(len(s)):
            if s[i] in s_to_t:
                if s_to_t[s[i]] != t[i]:#check if the conversion on 1 hasmap is equivalent
                    return False
            else:
                s_to_t[s[i]] = t[i]

            if t[i] in t_to_s:
                if t_to_s[t[i]] != s[i]:#check if the conversion the other way is equivalent
                    return False
            else:
                t_to_s[t[i]] = s[i]

        return True
